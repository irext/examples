<?xml version="1.0" encoding="utf-8"?>
<net.irext.ircontrol.ui.widget.SwipeRevealLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <!-- index 0: revealed action panel behind the content (red delete button) -->
    <Button
        android:id="@+id/btn_delete_remote"
        android:layout_width="88dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="@color/delete_button_bg"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:text="@string/button_delete"/>

    <!-- index 1: foreground content panel -->
    <LinearLayout
        android:id="@+id/ll_remote_foreground"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/item_foreground_bg"
        android:gravity="center_vertical"
        android:padding="4dp">

        <TextView
            android:id="@+id/tv_remote_name"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginLeft="10dp"
            android:gravity="center_vertical"
            android:singleLine="true"
            android:ellipsize="end"
            android:textStyle="bold"
            android:textSize="20sp"/>

    </LinearLayout>

</net.irext.ircontrol.ui.widget.SwipeRevealLayout>
